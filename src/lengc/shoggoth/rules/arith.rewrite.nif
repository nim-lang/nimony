(rules
  (rule (IF (add T X 0))               (DO X))
  (rule (IF (add T 0 X))               (DO X))
  (rule (IF (sub T X 0))               (DO X))
  (rule
    (IF (sub T (pure X) (same X)))
    (WHEN (isIntT T))
    (DO 0))
  (rule (IF (mul T X 1))               (DO X))
  (rule (IF (mul T 1 X))               (DO X))
  (rule (IF (mul T (pure X) 0))        (DO 0))
  (rule (IF (mul T 0 (pure X)))        (DO 0))
  (rule (IF (and (true) X))            (DO X))
  (rule (IF (or (false) X))            (DO X))
  (rule (IF (not (not X)))             (DO X))
  (rule (IF (deref (addr X)))          (DO X))
  (rule (IF (deref (haddr X)))         (DO X))
  (rule (IF (not (true)))              (DO (false)))
  (rule (IF (not (false)))             (DO (true)))
  (rule (IF (and (false) (pure X)))    (DO (false)))
  (rule (IF (or (true) (pure X)))      (DO (true)))
  (rule (IF (lt X Y)) (WHEN (litLt X Y)) (DO (true)))
  (rule (IF (lt X Y)) (WHEN (litLe Y X)) (DO (false)))
  (rule (IF (le X Y)) (WHEN (litLe X Y)) (DO (true)))
  (rule (IF (le X Y)) (WHEN (litLt Y X)) (DO (false)))
  (rule (IF (eq X Y)) (WHEN (litEq X Y)) (DO (true)))
  (rule (IF (eq X Y)) (WHEN (litNeq X Y)) (DO (false)))
  (rule (IF (neq X Y)) (WHEN (litNeq X Y)) (DO (true)))
  (rule (IF (neq X Y)) (WHEN (litEq X Y)) (DO (false)))
  (rule (IF (ite (true) A B))          (DO A))
  (rule (IF (ite (false) A B))         (DO B))
  (rule (IF (continue (true)))         (DO (continue .)))
)
